         </DockPanel>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0"><Button x:Name="RemoveSeeds" Content="선택 삭제" Style="{StaticResource Link}" ToolTip="선택한 프리셋을 목록에서 제외합니다. 원본 파일은 그대로 유지됩니다. (Delete)"/><Button x:Name="ClearSeeds" Content="비우기" ToolTip="등록한 씨드를 목록에서 모두 제외합니다. 원본 파일은 그대로 유지됩니다." Style="{StaticResource Link}"/></StackPanel>
        </StackPanel>
        <Grid>
         <DataGrid x:Name="SeedGrid" SelectionMode="Extended" CanUserSortColumns="False"><DataGrid.Columns>
          <DataGridTemplateColumn Header="사용" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Use, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0" HorizontalAlignment="Center" Focusable="False"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="프리셋" Binding="{Binding name}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource TrimCell}"/>
          <DataGridTemplateColumn Header="마스크" Width="66"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Pill}" Padding="7,1" Visibility="{Binding Masks, Converter={StaticResource BoolVis}}" ToolTip="인물이나 배경 등 특정 영역에 적용하는 마스크가 포함되어 있습니다."><TextBlock Text="있음" FontSize="11.5" Foreground="{StaticResource Text2Brush}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns></DataGrid>
         <StackPanel x:Name="SeedEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,36,20,0" IsHitTestVisible="False">
          <Border Style="{StaticResource EmptyIcon}"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentBrush}"/></Border>
          <TextBlock Text="XMP를 여기로 끌어다 놓으세요" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
         </StackPanel>
        </Grid>
       </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="2" Style="{StaticResource PageScroll}">
       <StackPanel Margin="0,0,8,0">
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="KeywordSummary" Text="선택 없음" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/><Button x:Name="KeywordClear" Content="모두 해제" Style="{StaticResource Link}" Visibility="Collapsed"/></StackPanel>
           <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepText}"/></Border><TextBlock Text="탐색할 분위기" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="60개 키워드 중 원하는 분위기를 고르세요. 선택한 키워드는 후보마다 나눠 적용합니다. 아무것도 고르지 않으면 자연스러운 방향으로 변주합니다."/></StackPanel></DockPanel>
          <Border Style="{StaticResource CardGap}"/>
          <WrapPanel x:Name="KeywordGroups"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="3" Style="{StaticResource StepText}"/></Border><TextBlock Text="변주 설정" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="충실도로 원래 색감을 얼마나 유지할지, 변주 폭으로 변화의 크기를 정하세요. 서로 너무 비슷한 후보는 저장에서 제외될 수 있습니다."/></StackPanel>
          <Border Style="{StaticResource CardGap}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel>
            <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}"><TextBlock x:Name="FidelityValue" Text="85" Style="{StaticResource ValueText}"/></Border><TextBlock Text="씨드 충실도" Style="{StaticResource FieldTitle}"/></DockPanel>
            <Slider x:Name="Fidelity" Minimum="0" Maximum="100" Value="85" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,10,0,0" ToolTip="높일수록 씨드의 색감을 더 많이 유지합니다. 100에서는 색감과 화이트밸런스를 고정하며, 밝기와 질감은 변할 수 있습니다."/>
           </StackPanel>
           <StackPanel Grid.Column="2">
            <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}"><TextBlock x:Name="VariationValue" Text="70" Style="{StaticResource ValueText}"/></Border><TextBlock Text="변주 폭" Style="{StaticResource FieldTitle}"/></DockPanel>
            <Slider x:Name="Variation" Minimum="0" Maximum="100" Value="70" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,10,0,0" ToolTip="높일수록 보정값의 변화가 커집니다. 0이면 씨드의 보정값을 유지합니다."/>
           </StackPanel>
          </Grid>
          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,14"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="인물·배경 마스크" Style="{StaticResource FieldTitle}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="선택한 영역의 자동 마스크를 프리셋에 추가합니다. 인물·피사체는 Lightroom의 피사체 선택, 배경은 그 선택 영역의 반전을 사용합니다. AI 사용을 꺼도 추가할 수 있습니다."/></StackPanel>
          <WrapPanel><CheckBox x:Name="AutoSubjectMask" Content="인물·피사체 추가"/><CheckBox x:Name="AutoBackgroundMask" Content="배경 추가"/></WrapPanel>
          <TextBlock Text="실제 영역은 Lightroom에서 프리셋을 적용할 때 계산합니다." Style="{StaticResource Muted}" Margin="0,4,0,16"/>
          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,14"/>
          <TextBlock Text="다른 XMP의 마스크 가져오기 · 선택 사항" Style="{StaticResource Label}"/>
          <TextBlock Text="Lightroom에서 마스크를 포함해 저장한 XMP를 선택하세요. 생성 결과에서는 이 파일의 마스크가 씨드의 기존 마스크를 대체합니다." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
          <DockPanel><Button x:Name="MaskClear" DockPanel.Dock="Right" Tag="&#xE711;" Margin="8,0,0,0" Padding="10,0" ToolTip="가져올 XMP를 해제하고 씨드의 기존 마스크를 사용합니다." AutomationProperties.Name="가져올 마스크 XMP 해제" Visibility="Collapsed"/><Button x:Name="MaskButton" DockPanel.Dock="Right" Content="XMP 선택" Tag="&#xE8E5;" Margin="12,0,0,0" ToolTip="이 파일에서 마스크의 선택 영역과 영역별 보정값을 가져옵니다. 전체 사진의 보정은 씨드 프리셋을 기준으로 합니다. 위에서 체크한 자동 마스크는 함께 추가됩니다."/><TextBlock x:Name="MaskPath" Text="선택 안 함" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
          <CheckBox x:Name="VaryMasks" Content="기존 인물·배경 마스크의 보정값도 변경" Margin="0,14,0,0" ToolTip="씨드 또는 위에서 가져온 XMP의 마스크에 적용됩니다. 마스크 이름에 인물·피사체·배경 또는 Subject·Person·People·Portrait·Background가 포함되어 있거나, 이름이 BG인 경우에 인식합니다. 해당 마스크에 저장된 노출·대비·부분 대비·채도 값을 충실도와 변주 폭에 맞춰 바꾸며, 선택 영역은 유지합니다."/>
          <TextBlock Text="이름으로 인물·배경을 확인할 수 있는 마스크의 노출·대비·부분 대비·채도를 바꿉니다. 해제하면 기존 값을 유지합니다." Style="{StaticResource Muted}" Margin="24,4,0,0"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <DockPanel><CheckBox x:Name="UseAi" DockPanel.Dock="Right" Content="AI 사용" Style="{StaticResource Switch}" IsChecked="True" Margin="0" VerticalAlignment="Center"/>
           <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="4" Style="{StaticResource StepText}"/></Border><TextBlock Text="AI 보정 제안" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="AI가 씨드와 키워드를 참고해 보정 방향을 제안합니다. AI를 끄면 이 PC에서 변주하며 API 비용이 들지 않습니다."/></StackPanel></DockPanel>
          <Border Style="{StaticResource CardGap}"/>
          <StackPanel x:Name="AiFields" IsEnabled="{Binding IsChecked, ElementName=UseAi}">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="OpenAI API 키" Style="{StaticResource Label}"/><PasswordBox x:Name="ApiKey"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="모델" Style="{StaticResource Label}"/><TextBox x:Name="Model" Text="gpt-6-luna"/></StackPanel>
           </Grid>
           <DockPanel Margin="0,8,0,16"><CheckBox x:Name="RememberKey" DockPanel.Dock="Left" Content="이 PC에 API 키 저장" FontSize="12" Margin="0,0,14,0" ToolTip="API 키를 Windows 계정으로 암호화해 저장합니다. 이 옵션을 끄면 저장된 키를 삭제합니다."/></DockPanel>
           <TextBlock Text="프리셋을 적용할 사진 · 선택 사항" Style="{StaticResource Label}"/>
           <TextBlock Text="보정하려는 사진을 넣으면 AI가 밝기와 조명을 참고해 프리셋을 제안합니다. 선택한 사진은 AI에 전송되며, 사진 없이도 생성할 수 있습니다." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
           <DockPanel Margin="0,0,0,16">
            <Border Style="{StaticResource Thumb}"><Grid><TextBlock Text="&#xEB9F;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource FaintBrush}"/><Image x:Name="PhotoThumb" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="8" RadiusY="8"/></Image.Clip></Image></Grid></Border>
            <Button x:Name="PhotoClear" DockPanel.Dock="Right" Tag="&#xE711;" Padding="10,0" Margin="8,0,0,0" ToolTip="사진을 해제하고 씨드와 키워드를 바탕으로 제안받습니다." AutomationProperties.Name="프리셋을 적용할 사진 해제" Visibility="Collapsed"/>
            <Button x:Name="PhotoButton" DockPanel.Dock="Right" Content="사진 선택" Margin="8,0,0,0" ToolTip="실제로 보정할 JPG·PNG 사진을 선택하세요. AI 사용을 켜고 생성할 때 긴 변이 1024px 이하인 사본을 OpenAI에 전송합니다. 사진은 보정 방향을 정하는 데 사용하며, 결과는 XMP 프리셋으로 저장합니다."/>
            <TextBlock x:Name="PhotoPath" Text="선택 안 함" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
           </DockPanel>
           <TextBlock Text="원하는 보정" Style="{StaticResource Label}"/>
           <TextBox x:Name="Note" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8" Tag="예: 피부는 자연스럽게, 배경의 핑크는 유지"/>
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="5" Style="{StaticResource StepText}"/></Border><TextBlock Text="저장 폴더" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="생성할 때마다 이 위치에 새 폴더를 만들고, XMP와 생성 기록을 함께 저장합니다."/></StackPanel>
          <Border Style="{StaticResource CardGap}"/>
          <DockPanel><Button x:Name="ChooseOutput" DockPanel.Dock="Right" Content="변경" Tag="&#xE8B7;" Margin="8,0,0,0"/><TextBox x:Name="Output"/></DockPanel>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </ScrollViewer>

    <!-- Reference generator: 1 photos | 2 estimate, 3 masks, 4 settings, 5 keywords, 6 output -->
    <ScrollViewer x:Name="ReferencePage" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
     <Grid x:Name="ReferenceForm"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="300" MaxWidth="380"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.6*" MinWidth="440"/></Grid.ColumnDefinitions>
      <Border x:Name="RefCard" Style="{StaticResource Card}" AllowDrop="True">
       <DockPanel>
        <StackPanel DockPanel.Dock="Top">
         <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepText}"/></Border><TextBlock Text="레퍼런스 사진" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="참고할 색감의 JPG나 PNG를 1~24장 추가하세요. 사진이나 폴더를 이곳에 끌어다 놓아도 됩니다."/></StackPanel>
         <Border Style="{StaticResource CardGap}"/>
         <WrapPanel Margin="0,0,0,12"><Button x:Name="RefAdd" Content="사진 추가" Tag="&#xE710;" ToolTip="색감과 분위기를 참고할 사진을 추가합니다. (Ctrl+O)"/><Button x:Name="RefRemove" Content="선택 삭제" Tag="&#xE74D;" ToolTip="선택한 사진을 목록에서 제외합니다. 원본 파일은 그대로 유지됩니다. (Delete)"/></WrapPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="RefClear" DockPanel.Dock="Right" Content="비우기" Style="{StaticResource Link}" ToolTip="추가한 사진을 목록에서 모두 제외합니다."/><TextBlock x:Name="RefPhotoCount" Text="0장 선택 · 최대 24장" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="긴 변이 1024px 이하인 분석용 사본을 AI에 전송합니다."/></DockPanel>
        <Grid>
         <Border CornerRadius="10" Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
          <ListBox x:Name="ReferenceList" SelectionMode="Extended" BorderThickness="0" Background="Transparent" Padding="8,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
           <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
           <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Tile" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Background="White" Padding="4"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Tile" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers>
           </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
           <ListBox.ItemTemplate><DataTemplate>
            <StackPanel Width="80" ToolTip="{Binding name}">
             <Grid Height="60"><Rectangle RadiusX="6" RadiusY="6" Fill="#E6EAF0"/><Rectangle RadiusX="6" RadiusY="6"><Rectangle.Fill><ImageBrush ImageSource="{Binding thumb}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle></Grid>
             <TextBlock Text="{Binding id}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text2Brush}" Margin="2,5,0,0"/>
             <TextBlock Text="{Binding name}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,0,1"/>
            </StackPanel>
           </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
         </Border>
         <StackPanel x:Name="RefEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0" IsHitTestVisible="False">
          <Border Style="{StaticResource EmptyIcon}"><TextBlock Text="&#xEB9F;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentBrush}"/></Border>
          <TextBlock Text="사진을 여기로 끌어다 놓으세요" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
         </StackPanel>
        </Grid>
       </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="2" Style="{StaticResource PageScroll}">
       <StackPanel Margin="0,0,8,0">
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepText}"/></Border><TextBlock Text="스타일 추정" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="사진의 색감, 명암, 질감을 분석해 보정값을 제안합니다. 조명과 소재의 영향도 포함되므로 Lightroom에서 실제 사진에 적용하며 조절하세요."/></StackPanel>
          <Border Style="{StaticResource CardGap}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="OpenAI API 키" Style="{StaticResource Label}"/><PasswordBox x:Name="RefApiKey"/></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="모델 · 이미지 입력 지원" Style="{StaticResource Label}"/><TextBox x:Name="RefModel" Text="gpt-6-luna"/></StackPanel>
          </Grid>
          <DockPanel Margin="0,8,0,16"><CheckBox x:Name="RefRememberKey" DockPanel.Dock="Left" Content="이 PC에 API 키 저장" FontSize="12" Margin="0,0,14,0" ToolTip="API 키를 Windows 계정으로 암호화해 저장합니다. 이 옵션을 끄면 저장된 키를 삭제합니다."/></DockPanel>
          <StackPanel><TextBlock Text="스타일 분석 방식" Style="{StaticResource Label}"/><ComboBox x:Name="RefMode" SelectedIndex="0"><ComboBoxItem Content="사진들의 공통 스타일" Tag="common"/><ComboBoxItem Content="사진마다 다른 스타일" Tag="individual"/></ComboBox></StackPanel>
          <Border Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
           <StackPanel><CheckBox x:Name="RefSearch" Content="보정 자료 검색" Style="{StaticResource Switch}" IsChecked="True" Margin="0" FontWeight="SemiBold" ToolTip="사진 분석 결과에 맞는 보정 자료를 검색하고 출처를 기록합니다. AI 요청 1회와 검색 비용이 추가될 수 있습니다."/></StackPanel>
          </Border>
          <TextBlock Text="적용할 원본 사진 · 선택 사항" Style="{StaticResource Label}" Margin="0,16,0,6"/>
          <DockPanel>
           <Border Style="{StaticResource Thumb}"><Grid><TextBlock Text="&#xEB9F;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource FaintBrush}"/><Image x:Name="RefTargetThumb" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="8" RadiusY="8"/></Image.Clip></Image></Grid></Border>
           <Button x:Name="RefTargetClear" DockPanel.Dock="Right" Tag="&#xE711;" Padding="10,0" Margin="8,0,0,0" ToolTip="원본 사진 해제" AutomationProperties.Name="원본 사진 해제" Visibility="Collapsed"/>
           <Button x:Name="RefTargetButton" DockPanel.Dock="Right" Content="사진 선택" Margin="8,0,0,0" ToolTip="프리셋을 적용할 보정 전 사진을 선택하세요. 이 사진을 함께 분석해 필요한 보정값을 추정합니다."/>
           <TextBlock x:Name="RefTargetPath" Text="선택 안 함" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </DockPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="3" Style="{StaticResource StepText}"/></Border><TextBlock Text="인물·배경 보정" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="템플릿 없이 인물·피사체와 배경의 자동 마스크를 추가할 수 있습니다. 실제 선택 영역은 Lightroom에서 프리셋을 적용할 때 계산합니다. 직접 만든 템플릿도 선택해서 사용할 수 있습니다."/></StackPanel>
          <Border Style="{StaticResource CardGap}"/>
          <WrapPanel Margin="0,0,0,12"><CheckBox x:Name="RefSubject" Content="인물·피사체 보정" IsChecked="True" FontWeight="SemiBold"/><CheckBox x:Name="RefBackground" Content="배경 보정" IsChecked="True" FontWeight="SemiBold"/></WrapPanel>
          <ComboBox x:Name="RefMaskMode" SelectedIndex="0" Margin="0,0,0,12" ToolTip="자동 선택은 템플릿 파일 없이 사용합니다. 직접 만든 마스크를 가져오려면 템플릿 사용을 고르세요."><ComboBoxItem Content="자동 선택 · 템플릿 없이" Tag="automatic"/><ComboBoxItem Content="직접 만든 템플릿 사용" Tag="template"/></ComboBox>
          <StackPanel x:Name="RefMaskTemplateTools" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed"><Button x:Name="RefMaskButton" Content="템플릿 선택" Tag="&#xE8E5;"/><Button x:Name="RefMaskClear" Content="해제" Margin="0" Visibility="Collapsed"/></StackPanel>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <ComboBox x:Name="RefSubjectGroup" DisplayMemberPath="Label" Visibility="Collapsed" ToolTip="인물에 사용할 템플릿 마스크"/>
           <ComboBox x:Name="RefBackgroundGroup" Grid.Column="2" DisplayMemberPath="Label" Visibility="Collapsed" ToolTip="배경에 사용할 템플릿 마스크"/>
          </Grid>
          <Border x:Name="RefMaskInfoBox" Style="{StaticResource Callout}">
           <DockPanel><Border x:Name="RefMaskBar" Style="{StaticResource CalloutBar}"/><TextBlock x:Name="RefMaskIcon" Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" Margin="0,1,10,0" VerticalAlignment="Top"/><TextBlock x:Name="RefMaskInfo" Text="템플릿 없이 자동 마스크를 추가합니다. 영역은 Lightroom에서 계산합니다." Foreground="{StaticResource Text2Brush}" FontSize="12" TextWrapping="Wrap"/></DockPanel>
          </Border>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="4" Style="{StaticResource StepText}"/></Border><TextBlock Text="변주 설정" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="각 스타일의 첫 후보는 분석한 기본 보정값을 사용합니다. 나머지는 아래 설정에 따라 변주하며, 너무 비슷한 후보는 제외될 수 있습니다."/></StackPanel>
          <Border Style="{StaticResource CardGap}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel>
            <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}"><TextBlock x:Name="RefFidelityValue" Text="85" Style="{StaticResource ValueText}"/></Border><TextBlock Text="레퍼런스 충실도" Style="{StaticResource FieldTitle}"/></DockPanel>
            <Slider x:Name="RefFidelity" ToolTip="높일수록 분석한 스타일의 색감을 더 많이 유지합니다. 밝기와 질감은 변할 수 있습니다." Minimum="0" Maximum="100" Value="85" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,10,0,0"/>
           </StackPanel>
           <StackPanel Grid.Column="2">
            <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}"><TextBlock x:Name="RefVariationValue" Text="60" Style="{StaticResource ValueText}"/></Border><TextBlock Text="변주 폭" Style="{StaticResource FieldTitle}"/></DockPanel>
            <Slider x:Name="RefVariation" ToolTip="기본 후보 외에 만드는 변주의 크기입니다. 0이면 분석한 기본 보정값을 유지합니다." Minimum="0" Maximum="100" Value="60" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,10,0,0"/>
           </StackPanel>
          </Grid>
          <TextBlock Text="원하는 보정 · 선택" Style="{StaticResource Label}" Margin="0,18,0,6"/>
          <TextBox x:Name="RefNote" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8" Tag="예: 피부톤은 따뜻하게, 하늘은 덜 파랗게"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="RefKeywordSummary" Text="선택 없음" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/><Button x:Name="RefKeywordClear" Content="모두 해제" Style="{StaticResource Link}" Visibility="Collapsed"/></StackPanel>
           <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="5" Style="{StaticResource StepText}"/></Border><TextBlock Text="함께 탐색할 분위기" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="분석한 스타일에 더하고 싶은 분위기를 고르세요. 선택하지 않으면 기본 스타일을 바탕으로 자연스럽게 변주합니다."/></StackPanel></DockPanel>
          <Border Style="{StaticResource CardGap}"/>
          <WrapPanel x:Name="RefKeywordGroups"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="6" Style="{StaticResource StepText}"/></Border><TextBlock Text="저장 폴더" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="생성할 때마다 이 위치에 새 폴더를 만들고, XMP와 분석·생성 기록을 함께 저장합니다."/></StackPanel>
          <Border Style="{StaticResource CardGap}"/>
          <DockPanel><Button x:Name="RefChooseOutput" DockPanel.Dock="Right" Content="변경" Tag="&#xE8B7;" Margin="8,0,0,0"/><TextBox x:Name="RefOutput"/></DockPanel>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </ScrollViewer>

    <!-- Preset mix & match: 1 sources | 2 components, 3 base and range, 4 AI, 5 output -->
    <ScrollViewer x:Name="MixPage" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
     <Grid x:Name="MixForm"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="300" MaxWidth="380"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.6*" MinWidth="440"/></Grid.ColumnDefinitions>
      <Border x:Name="MixCard" Style="{StaticResource Card}" AllowDrop="True">
       <DockPanel>
        <StackPanel DockPanel.Dock="Top">
         <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepText}"/></Border><TextBlock Text="섞을 프리셋" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="섞을 XMP를 2~12개 추가하고 비율을 조절하세요. 입력한 비율은 합계가 100%가 되도록 환산하며, 0인 프리셋은 제외합니다."/></StackPanel>
         <Border Style="{StaticResource CardGap}"/>
         <WrapPanel Margin="0,0,0,4"><Button x:Name="MixAdd" Content="XMP 추가" Tag="&#xE710;" Margin="0,0,8,8"/><Button x:Name="MixFolder" Content="폴더 추가" Tag="&#xE8B7;" Margin="0,0,8,8"/><Button x:Name="MixFromSeeds" Content="씨드에서 가져오기" ToolTip="씨드 목록에서 사용하도록 체크한 프리셋을 가져옵니다." Margin="0,0,8,8"/></WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MixEqual" Content="비율 균등하게" ToolTip="등록한 모든 프리셋을 같은 비율로 설정합니다." Style="{StaticResource Link}"/><Button x:Name="MixRemove" Content="선택 삭제" Style="{StaticResource Link}" ToolTip="선택한 프리셋을 혼합 목록에서 제외합니다. (Delete)"/></StackPanel>
         <TextBlock x:Name="MixSummary" Text="섞을 프리셋을 2개 이상 추가하세요." Style="{StaticResource Muted}" MaxHeight="36" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        <DataGrid x:Name="MixGrid" SelectionMode="Extended" CanUserSortColumns="False"><DataGrid.Columns>
         <DataGridTextColumn Header="프리셋" Binding="{Binding name}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource TrimCell}"/>
         <DataGridTemplateColumn Header="혼합 비율" Width="124"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Slider x:Name="RatioSlider" ToolTip="다른 프리셋과 비교한 혼합 비율입니다. 0이면 이 프리셋을 제외합니다." Value="{Binding weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,0,8,0" AutomationProperties.Name="혼합 비율"/><TextBlock Grid.Column="1" Text="{Binding Value, ElementName=RatioSlider, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns></DataGrid>
       </DockPanel>
      </Border>
      <ScrollViewer Grid.Column="2" Style="{StaticResource PageScroll}">
       <StackPanel Margin="0,0,8,0">
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <DockPanel><Button x:Name="MixRandomAll" DockPanel.Dock="Right" Content="모두 랜덤으로" Margin="12,0,0,0" ToolTip="톤·색감·질감·커브와 기준 프리셋을 모두 랜덤으로 설정합니다. 생성할 때 후보마다 새로운 조합을 만듭니다."/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepText}"/></Border><TextBlock Text="항목별 믹스매치" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="항목마다 랜덤으로 섞거나, 지정한 비율로 섞거나, 특정 프리셋에서 가져올 수 있습니다. 모두 랜덤으로 버튼은 기준 프리셋까지 후보마다 새로 고르게 합니다."/></StackPanel></DockPanel>
          <Border Style="{StaticResource CardGap}"/>
          <TextBlock x:Name="MixRandomHint" Text="랜덤 항목은 비율이 0보다 큰 프리셋 중에서 출처와 비율을 새로 고릅니다. 슬라이더의 비율은 따르지 않으며, AI를 켜면 완성된 조합을 조금 다듬습니다." Style="{StaticResource Muted}" Margin="0,0,0,14" Visibility="Collapsed"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <StackPanel Margin="0,0,0,14"><TextBlock Text="톤" Style="{StaticResource Label}"/><ComboBox x:Name="MixTone" ToolTip="노출과 대비, 밝은 영역과 어두운 영역의 보정값을 가져옵니다." DisplayMemberPath="label" SelectedValuePath="id"/></StackPanel>
           <StackPanel Grid.Column="2" Margin="0,0,0,14"><TextBlock Text="색감" Style="{StaticResource Label}"/><ComboBox x:Name="MixColor" ToolTip="HSL, 채도, 토닝 등 색감 관련 보정값을 가져옵니다." DisplayMemberPath="label" SelectedValuePath="id"/></StackPanel>
           <StackPanel Grid.Row="1"><TextBlock Text="질감" Style="{StaticResource Label}"/><ComboBox x:Name="MixTexture" ToolTip="텍스처, 클래리티, 디헤이즈, 그레인의 보정값을 가져옵니다." DisplayMemberPath="label" SelectedValuePath="id"/></StackPanel>
           <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="커브" Style="{StaticResource Label}"/><ComboBox x:Name="MixCurves" ToolTip="여러 커브를 섞을 때는 5개 밝기 지점으로 보간합니다. 실제 효과는 Lightroom에서 확인하세요." DisplayMemberPath="label" SelectedValuePath="id"/></StackPanel>
          </Grid>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="3" Style="{StaticResource StepText}"/></Border><TextBlock Text="조합 설정" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="화이트밸런스·프로필·마스크 등은 기준 프리셋에서 가져옵니다. 기준도 랜덤으로 고를 수 있습니다. 조합 탐색 폭을 높이면 혼합 비율과 랜덤 조합을 더 다양하게 만듭니다."/></StackPanel>
          <Border Style="{StaticResource CardGap}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="기준 프리셋" Style="{StaticResource Label}"/><ComboBox x:Name="MixBase" DisplayMemberPath="name" SelectedValuePath="id" ToolTip="화이트밸런스·프로필·마스크 등 혼합하지 않는 설정의 출처입니다. 랜덤을 고르면 비율이 0보다 큰 프리셋 중에서 후보마다 하나를 무작위로 선택합니다. 실제로 사용된 기준은 결과에 표시됩니다."/>
           </StackPanel>
           <StackPanel Grid.Column="2">
            <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}"><TextBlock x:Name="MixVariationValue" Text="40" Style="{StaticResource ValueText}"/></Border><TextBlock Text="조합 탐색 폭" Style="{StaticResource FieldTitle}"/></DockPanel>
            <Slider x:Name="MixVariation" Minimum="0" Maximum="100" Value="40" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,8,0,0" ToolTip="비율대로 섞기는 0이면 지정 비율을 유지하고, 값을 높이면 추가 후보의 비율을 바꿉니다. 랜덤으로 섞기는 0이어도 항목별 출처를 무작위로 고르며, 값을 높일수록 여러 프리셋을 섞는 조합이 늘어납니다. AI 추천 반영도 함께 커지며 랜덤 항목은 최대 20%로 제한합니다."/>
           </StackPanel>
          </Grid>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource StackCard}">
         <StackPanel>
          <DockPanel><CheckBox x:Name="MixUseAi" DockPanel.Dock="Right" Content="AI 사용" Style="{StaticResource Switch}" IsChecked="False" Margin="0" VerticalAlignment="Center"/>
           <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="4" Style="{StaticResource StepText}"/></Border><TextBlock Text="AI 조합 추천" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="AI가 보정값과 요청사항을 보고 혼합 비율을 추천합니다. 랜덤 항목은 먼저 완성한 조합을 AI에 보여 주고, 추천 비율을 최대 20% 반영해 다듬습니다. 직접 지정한 항목과 후보별 기준 프리셋은 유지합니다. AI를 끄면 API 비용 없이 섞습니다."/></StackPanel></DockPanel>
          <Border Style="{StaticResource CardGap}"/>
          <StackPanel IsEnabled="{Binding IsChecked, ElementName=MixUseAi}">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="OpenAI API 키" Style="{StaticResource Label}"/><PasswordBox x:Name="MixApiKey"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="모델" Style="{StaticResource Label}"/><TextBox x:Name="MixModel" Text="gpt-6-luna"/></StackPanel>
           </Grid>
           <DockPanel Margin="0,8,0,16"><CheckBox x:Name="MixRememberKey" DockPanel.Dock="Left" Content="이 PC에 API 키 저장" FontSize="12" Margin="0,0,14,0" ToolTip="API 키를 Windows 계정으로 암호화해 저장합니다. 이 옵션을 끄면 저장된 키를 삭제합니다."/></DockPanel>
           <TextBlock Text="원하는 조합 · 선택 사항" Style="{StaticResource Label}"/>
           <TextBox x:Name="MixNote" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8" Tag="예: 첫 프리셋의 따뜻함을 중심으로, 두 번째 프리셋의 부드러운 명암을 더해 주세요."/>
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="5" Style="{StaticResource StepText}"/></Border><TextBlock Text="저장 폴더" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="생성할 때마다 이 위치에 새 폴더를 만들고, XMP와 생성 기록을 함께 저장합니다."/></StackPanel>
          <Border Style="{StaticResource CardGap}"/>
          <DockPanel><Button x:Name="MixChooseOutput" DockPanel.Dock="Right" Content="변경" Tag="&#xE8B7;" Margin="8,0,0,0"/><TextBox x:Name="MixOutput"/></DockPanel>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </ScrollViewer>

    <!-- Results -->
    <Grid x:Name="ResultsPage" Visibility="Collapsed">
     <Border x:Name="ResultsEmpty" Style="{StaticResource Card}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
       <Border Style="{StaticResource EmptyIcon}" Width="64" Height="64" CornerRadius="32"><TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource AccentBrush}"/></Border>
       <TextBlock Text="아직 생성한 프리셋이 없습니다" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
       <TextBlock Text="프리셋을 만들면 이곳에서 결과와 보정값을 확인할 수 있습니다." Style="{StaticResource Muted}" TextAlignment="Center"/>
       <Button x:Name="ResultsGoGenerate" Content="프리셋 생성으로 이동" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
      </StackPanel>
     </Border>
     <Grid x:Name="ResultsBody" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16">
       <DockPanel>
        <Button x:Name="ResultsOpenFolder" DockPanel.Dock="Right" Content="결과 폴더 열기" Tag="&#xE838;" Margin="0" VerticalAlignment="Center"/>
        <Border x:Name="ResultBadge" Style="{StaticResource IconChip}" Width="42" Height="42" CornerRadius="21" Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock x:Name="ResultBadgeIcon" Text="&#xE73E;" Style="{StaticResource IconChipGlyph}" FontSize="17"/></Border>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ResultSummary" Text="프리셋 생성 완료" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ResultMeta" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
       </DockPanel>
      </Border>
      <Border x:Name="ResultsNotice" Grid.Row="1" Style="{StaticResource Callout}" Margin="0,0,0,16" Visibility="Collapsed">
       <DockPanel><Border Style="{StaticResource CalloutBar}"/><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" Margin="0,3,10,0" VerticalAlignment="Top"/><TextBlock x:Name="Detail" TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}" FontSize="12" LineHeight="18"/></DockPanel>
      </Border>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.9*" MinWidth="280" MaxWidth="360"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}">
        <DockPanel>
         <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock Text="생성된 후보" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="프리셋을 선택하면 오른쪽에서 보정값과 생성 이유를 확인할 수 있습니다. 더블클릭하면 파일 위치를 엽니다."/></StackPanel></StackPanel>
         <DataGrid x:Name="Results" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding No}" Width="48" HeaderStyle="{StaticResource NumHeader}" ElementStyle="{StaticResource NumCell}"/>
          <DataGridTextColumn Header="기준 스타일" Binding="{Binding Seed}" Width="*" ElementStyle="{StaticResource TrimCell}"/>
          <DataGridTextColumn Header="키워드" Binding="{Binding Keyword}" Width="100" ElementStyle="{StaticResource TrimCell}"/>
          <DataGridTextColumn Header="보정값" Binding="{Binding Changed}" Width="62" HeaderStyle="{StaticResource NumHeader}" ElementStyle="{StaticResource NumCell}"/>
          <DataGridTextColumn Header="마스크" Binding="{Binding MaskChanges}" Width="62" HeaderStyle="{StaticResource NumHeader}" ElementStyle="{StaticResource NumCell}"/>
          <DataGridTextColumn Header="방식" Binding="{Binding ModeText}" Width="84"/>
         </DataGrid.Columns></DataGrid>
        </DockPanel>
       </Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
         <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
          <TextBlock Text="&#xE8A1;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource FaintBrush}"/>
          <TextBlock Text="왼쪽에서 후보를 선택하세요" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
         </StackPanel>
         <ScrollViewer x:Name="DetailPanel" Style="{StaticResource PageScroll}" Visibility="Collapsed">
          <StackPanel Margin="20">
           <TextBlock x:Name="DetailName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
           <WrapPanel Margin="0,10,0,0">
            <Border CornerRadius="10" Background="{StaticResource AccentBrush}" Padding="9,2" Margin="0,0,6,6"><TextBlock x:Name="DetailKeyword" Foreground="White" FontSize="12" FontWeight="SemiBold"/></Border>
            <Border Style="{StaticResource Pill}" Margin="0,0,6,6"><TextBlock x:Name="DetailMode" Foreground="{StaticResource Text2Brush}" FontSize="12"/></Border>
           </WrapPanel>
           <TextBlock Text="기준 스타일" Style="{StaticResource Section}" Margin="0,12,0,4"/><TextBlock x:Name="DetailSeed" TextWrapping="Wrap"/>
           <TextBlock Text="생성 이유" Style="{StaticResource Section}" Margin="0,16,0,4"/><TextBlock x:Name="DetailReason" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource Text2Brush}"/>
           <TextBlock x:Name="DetailChangesTitle" Text="씨드 대비 변경" Style="{StaticResource Section}" Margin="0,16,0,8"/><WrapPanel x:Name="DetailChanges"/>
           <StackPanel x:Name="DetailLocal"/>
           <TextBlock Text="파일" Style="{StaticResource Section}" Margin="0,12,0,4"/>
           <DockPanel><Button x:Name="RevealFile" DockPanel.Dock="Right" Content="위치 열기" Tag="&#xE838;" Margin="8,0,0,0"/><TextBlock x:Name="DetailFile" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text2Brush}"/></DockPanel>
           <TextBlock x:Name="DetailMask" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
          </StackPanel>
         </ScrollViewer>
        </Grid>
       </Border>
      </Grid>
     </Grid>
    </Grid>
   </Grid>

   <!-- Action bar -->
   <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,12" Margin="0,16,0,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="RunSummary" Grid.ColumnSpan="2" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" Visibility="Collapsed"/>
     <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="Cancel" Content="중지" Tag="&#xE71A;" Style="{StaticResource Danger}" IsEnabled="False" Visibility="Collapsed"/>
      <Button x:Name="OpenOutput" Content="결과 폴더" Tag="&#xE838;" MinHeight="40" IsEnabled="False" Visibility="Collapsed"/>
      <StackPanel x:Name="CountGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"><TextBlock Text="생성 개수" Style="{StaticResource FieldTitle}" Margin="0,0,8,0"/><TextBox x:Name="Count" Text="24" Width="64" MinHeight="40" HorizontalContentAlignment="Center" ToolTip="1~120개를 입력하세요. 선택한 씨드에 비슷한 수로 나누어 생성합니다."/></StackPanel>
      <StackPanel x:Name="RefCountGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"><TextBlock Text="생성 개수" Style="{StaticResource FieldTitle}" Margin="0,0,8,0"/><TextBox x:Name="RefCount" Text="12" Width="64" MinHeight="40" HorizontalContentAlignment="Center" ToolTip="1~120개를 입력하세요. 사진별 스타일을 선택했다면 사진 수 이상의 개수가 필요합니다."/></StackPanel>
      <StackPanel x:Name="MixCountGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"><TextBlock Text="생성 개수" Style="{StaticResource FieldTitle}" Margin="0,0,8,0"/><TextBox x:Name="MixCount" Text="1" Width="64" MinHeight="40" HorizontalContentAlignment="Center" ToolTip="1~24개를 입력하세요. 같은 결과가 반복되면 실제 생성 개수는 줄어들 수 있습니다."/></StackPanel>
      <Button x:Name="Generate" Content="프리셋 생성" Tag="&#xE768;" Style="{StaticResource Primary}" Margin="0" ToolTip="현재 설정으로 프리셋을 만듭니다. (Ctrl+Enter)"/>
     </StackPanel>
     <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,16,0">
      <TextBlock x:Name="Status" Text="준비됨 · 내 프리셋을 추가해 시작하세요." ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
      <ProgressBar x:Name="Progress" Margin="0,8,0,2" MaxWidth="380" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
