        <DockPanel><TextBlock x:Name="HistoryHint" DockPanel.Dock="Right" Text="선택 기간의 최근 200건" Style="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><TextBlock Text="사용 기록" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="이 앱의 AI 요청과 생성 작업을 기록합니다. 표시되는 비용은 사용 기록을 바탕으로 계산한 예상 금액입니다."/></StackPanel></DockPanel>
