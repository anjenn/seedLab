    <DataTrigger Binding="{Binding Status}" Value="실패 / 미확인"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="요청 거절"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="중지"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarnBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="응답 미완료"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarnBrush}"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>

