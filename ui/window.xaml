    </ScrollViewer>

    <!-- Seed generator: 1 sources | 2 keywords, 3 settings, 4 AI, 5 output -->
    <ScrollViewer x:Name="GeneratorPage" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
     <Grid x:Name="GeneratorForm"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="300" MaxWidth="380"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.6*" MinWidth="440"/></Grid.ColumnDefinitions>
      <Border x:Name="SeedCard" Style="{StaticResource Card}" AllowDrop="True">
       <DockPanel>
        <StackPanel DockPanel.Dock="Top">
         <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepText}"/></Border><TextBlock Text="씨드 프리셋" Style="{StaticResource Title}"/><TextBlock Style="{StaticResource InfoIcon}" ToolTip="새 프리셋의 바탕이 될 Lightroom XMP를 추가하세요. 파일이나 폴더를 이곳에 끌어다 놓아도 됩니다."/></StackPanel>
         <Border Style="{StaticResource CardGap}"/>
         <WrapPanel Margin="0,0,0,12"><Button x:Name="AddFiles" Content="XMP 추가" Tag="&#xE710;" ToolTip="Lightroom에서 내보낸 XMP 프리셋을 추가합니다. (Ctrl+O)"/><Button x:Name="AddFolder" Content="폴더 추가" Tag="&#xE8B7;" Margin="0" ToolTip="선택한 폴더와 하위 폴더의 XMP를 함께 추가합니다."/></WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
         <DockPanel><Button x:Name="SeedToggleAll" DockPanel.Dock="Right" Content="모두 해제" Style="{StaticResource Link}"/>
